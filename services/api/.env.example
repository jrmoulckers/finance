# =============================================================================
# Finance App — Local Development Environment
# =============================================================================
# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# These values are used by Edge Functions, local scripts, and test harnesses.
# The Supabase CLI prints the anon and service-role keys when you run
# `supabase start` — paste them below.
#
# NEVER commit the .env file. It is already in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase local instance
#
# For the #1886 alpha topology the Edge Functions run locally against
# Supabase Cloud as the identity provider. Override SUPABASE_URL with the
# Cloud project URL (e.g. https://<ref>.supabase.co) when running the
# cookie-bearing auth proxy locally; SUPABASE_ANON_KEY must match.
# ---------------------------------------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ---------------------------------------------------------------------------
# Auth / Edge Function secrets
# ---------------------------------------------------------------------------
AUTH_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE
JWT_SECRET=YOUR_JWT_SECRET_HERE
GITHUB_FEEDBACK_TOKEN=YOUR_GITHUB_FEEDBACK_TOKEN_HERE

# ---------------------------------------------------------------------------
# Web auth proxy (#1886)
#
# OAUTH_REDIRECT_BASE is the public origin of the web app — the OAuth
# `oauth-start` and `oauth-callback` functions use it to construct the
# Supabase redirect target and the post-login bounce URL. In dev this is
# `http://localhost:5173`; in prod set to the Azure Front Door origin.
# ---------------------------------------------------------------------------
OAUTH_REDIRECT_BASE=http://localhost:5173

# ---------------------------------------------------------------------------
# WebAuthn / Passkey configuration
# ---------------------------------------------------------------------------
WEBAUTHN_RP_NAME=Finance App (Local)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# PowerSync (optional — only needed when testing sync locally)
# ---------------------------------------------------------------------------
POWERSYNC_URL=YOUR_POWERSYNC_URL_HERE
POWERSYNC_PUBLIC_KEY=YOUR_POWERSYNC_PUBLIC_KEY_HERE

# ---------------------------------------------------------------------------
# Bank Connection API (Plaid / MX)
#
# Plaid is the reference aggregator implementation (#3848). PLAID_ENVIRONMENT
# selects the API host: sandbox | development | production. PLAID_WEBHOOK_URL
# is the public URL Plaid posts async updates to (the bank-webhook function).
# BANK_ENCRYPTION_KEY must be a 64-char hex string (32 bytes) used for
# AES-256-GCM encryption of stored access tokens.
#
# NOTE: Plaid webhooks are verified via the signed JWT (JWS) in the
# Plaid-Verification header using PLAID_CLIENT_ID/PLAID_SECRET — there is no
# separate Plaid webhook shared secret. MX does not sign webhook bodies at all,
# so MX_WEBHOOK_SECRET is instead carried in the `token` query parameter of the
# webhook URL registered in the MX dashboard, and compared in constant time.
#
# MX is a real aggregator path (#4371). MX_ENVIRONMENT selects the API host:
# sandbox | integration -> https://int-api.mx.com, production -> https://api.mx.com.
# ---------------------------------------------------------------------------
PLAID_CLIENT_ID=YOUR_PLAID_CLIENT_ID_HERE
PLAID_SECRET=YOUR_PLAID_SECRET_HERE
PLAID_ENVIRONMENT=sandbox
PLAID_WEBHOOK_URL=https://YOUR_PROJECT_REF.functions.supabase.co/bank-webhook?provider=plaid
MX_CLIENT_ID=YOUR_MX_CLIENT_ID_HERE
MX_API_KEY=YOUR_MX_API_KEY_HERE
MX_ENVIRONMENT=sandbox
MX_WEBHOOK_SECRET=YOUR_MX_WEBHOOK_SECRET_HERE
BANK_ENCRYPTION_KEY=YOUR_32_BYTE_AES_KEY_HEX_HERE

# ---------------------------------------------------------------------------
# RevenueCat evidence ingress (Apple / Google)
#
# Keep the reviewed app/product maps server-side. Every logical catalog entry
# binds its distinct RevenueCat v2 product ID and store SKU aliases to one
# reviewed app and may map only to base_plan tiers plus, premium, or family.
# The reconciliation credential is distinct from the webhook Authorization.
# ---------------------------------------------------------------------------
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer YOUR_REVENUECAT_WEBHOOK_AUTHORIZATION_HERE
REVENUECAT_WEBHOOK_SIGNATURE_SECRETS=YOUR_CURRENT_SIGNATURE_SECRET_HERE,YOUR_PREVIOUS_SIGNATURE_SECRET_HERE
REVENUECAT_RECONCILIATION_AUTHORIZATION=Bearer YOUR_RECONCILIATION_SECRET_HERE
REVENUECAT_API_KEY=YOUR_REVENUECAT_V2_SECRET_KEY_HERE
REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v2
REVENUECAT_ACCOUNT_ID=YOUR_REVENUECAT_ACCOUNT_ID_HERE
REVENUECAT_PROJECT_ID=YOUR_REVENUECAT_PROJECT_ID_HERE
REVENUECAT_ENVIRONMENT=sandbox
REVENUECAT_APP_MAP_JSON={"YOUR_APPLE_APP_ID":{"accountId":"YOUR_REVENUECAT_ACCOUNT_ID_HERE","projectId":"YOUR_REVENUECAT_PROJECT_ID_HERE","store":"APP_STORE"},"YOUR_GOOGLE_APP_ID":{"accountId":"YOUR_REVENUECAT_ACCOUNT_ID_HERE","projectId":"YOUR_REVENUECAT_PROJECT_ID_HERE","store":"PLAY_STORE"}}
REVENUECAT_PRODUCT_MAP_JSON={"apple_plus":{"appId":"YOUR_APPLE_APP_ID","revenueCatProductId":"YOUR_REVENUECAT_APPLE_PLUS_PRODUCT_ID","storeProductIdentifiers":["YOUR_APPLE_PLUS_STORE_SKU"],"logicalProduct":"base_plan","tier":"plus"},"apple_premium":{"appId":"YOUR_APPLE_APP_ID","revenueCatProductId":"YOUR_REVENUECAT_APPLE_PREMIUM_PRODUCT_ID","storeProductIdentifiers":["YOUR_APPLE_PREMIUM_STORE_SKU"],"logicalProduct":"base_plan","tier":"premium"},"apple_family":{"appId":"YOUR_APPLE_APP_ID","revenueCatProductId":"YOUR_REVENUECAT_APPLE_FAMILY_PRODUCT_ID","storeProductIdentifiers":["YOUR_APPLE_FAMILY_STORE_SKU"],"logicalProduct":"base_plan","tier":"family"},"google_plus":{"appId":"YOUR_GOOGLE_APP_ID","revenueCatProductId":"YOUR_REVENUECAT_GOOGLE_PLUS_PRODUCT_ID","storeProductIdentifiers":["YOUR_GOOGLE_PLUS_STORE_SKU"],"logicalProduct":"base_plan","tier":"plus"},"google_premium":{"appId":"YOUR_GOOGLE_APP_ID","revenueCatProductId":"YOUR_REVENUECAT_GOOGLE_PREMIUM_PRODUCT_ID","storeProductIdentifiers":["YOUR_GOOGLE_PREMIUM_STORE_SKU"],"logicalProduct":"base_plan","tier":"premium"},"google_family":{"appId":"YOUR_GOOGLE_APP_ID","revenueCatProductId":"YOUR_REVENUECAT_GOOGLE_FAMILY_PRODUCT_ID","storeProductIdentifiers":["YOUR_GOOGLE_FAMILY_STORE_SKU"],"logicalProduct":"base_plan","tier":"family"}}

# ---------------------------------------------------------------------------
# Social OAuth providers (#3187)
#
# Required to enable "Continue with Google / GitHub / Apple" in the deployed
# Supabase Auth instance. Without these, GoTrue returns
# "Unsupported provider: provider is not enabled" and the buttons fail.
#
# Set the authorized redirect URL for EACH provider to:
#   ${OAUTH_REDIRECT_BASE}/api/auth/oauth-callback
#
# After providing the secrets, flip enabled = true for the provider in
# services/api/supabase/config.toml (or enable it in the Supabase dashboard).
# See services/api/docs/oauth-providers.md.
# ---------------------------------------------------------------------------
OAUTH_REDIRECT_BASE=https://finance.jrmoulckers.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=YOUR_GOOGLE_OAUTH_SECRET_HERE
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID_HERE
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=YOUR_GITHUB_OAUTH_SECRET_HERE
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=YOUR_APPLE_SERVICES_ID_HERE
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=YOUR_APPLE_OAUTH_SECRET_HERE
