{
  "name": "@finance/api",
  "version": "0.0.0",
  "private": true,
  "description": "Finance app — Supabase Edge Functions API and documentation",
  "license": "BUSL-1.1",
  "scripts": {
    "docs:api": "npx @redocly/cli preview-docs openapi.yaml",
    "docs:api:lint": "npx @redocly/cli lint openapi.yaml",
    "docs:api:bundle": "npx @redocly/cli bundle openapi.yaml -o docs/openapi-bundled.yaml",
    "supabase:start": "npx --yes supabase start",
    "supabase:stop": "npx --yes supabase stop",
    "supabase:reset": "npx --yes supabase db reset",
    "supabase:migrate": "npx --yes supabase migration up",
    "supabase:status": "npx --yes supabase status",
    "supabase:functions": "npx --yes supabase functions serve",
    "setup": "bash scripts/setup-local.sh",
    "setup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local.ps1",
    "test:sync-contract": "deno test --allow-read supabase/tests/sync-contract.test.ts",
    "test:billing-entitlements": "psql -v ON_ERROR_STOP=1 -f supabase/tests/billing-entitlements-integration.test.sql",
    "test:bank-connection-cap": "psql -v ON_ERROR_STOP=1 -f supabase/tests/bank-connection-cap.test.sql",
    "test:bank-connection-cap-remediation": "psql -v ON_ERROR_STOP=1 -f supabase/tests/bank-connection-cap-remediation.test.sql",
    "test:bank-entitlements": "deno test --config supabase/functions/deno.json --allow-env supabase/functions/_shared/bank-entitlements.test.ts",
    "test:bank-connection-handler": "deno test --config supabase/functions/deno.json --no-check --allow-env --allow-net supabase/functions/bank-connection/index_test.ts supabase/functions/account-delete/index_test.ts",
    "test:bank-revocation-handlers": "deno test --config supabase/functions/deno.json --no-check --allow-env --allow-net supabase/functions/_shared/bank-revocation.test.ts supabase/functions/_shared/bank-revocation-outbox.test.ts supabase/functions/bank-connection/index_test.ts supabase/functions/bank-webhook/index.test.ts supabase/functions/account-delete/index_test.ts supabase/functions/process-bank-revocations/index_test.ts",
    "test:bank-revocation-concurrency": "pwsh -File supabase/tests/bank-revocation-concurrency.test.ps1",
    "test:bank-revocation-durable-sql": "docker exec -i supabase_db_finance-local psql -U supabase_admin -d postgres -v ON_ERROR_STOP=1 < supabase/tests/bank-revocation-durable.test.sql",
    "test:entitlement-api": "psql -v ON_ERROR_STOP=1 -f supabase/tests/entitlement-api-contract.test.sql",
    "test:entitlement-gateway": "node --test supabase/tests/entitlement-gateway.integration.test.mjs",
    "test:sync-integration": "psql postgresql://postgres:postgres@localhost:54322/postgres -f supabase/tests/sync-integration.test.sql"
  },
  "devDependencies": {
    "@redocly/cli": "^2.31.5",
    "yaml": "^2.9.0"
  }
}
