{
  "animation": {
    "$description": "Semantic animation tokens — map motion primitives to UI purposes",
    "pageTransition": {
      "$description": "Page-level enter/exit transitions (route changes, full-screen sheets)",
      "duration": { "$value": "{duration.normal}", "$type": "duration" },
      "easing": { "$value": "{easing.standard}", "$type": "cubicBezier" }
    },
    "listItem": {
      "$description": "List/grid item staggered enter animations",
      "duration": { "$value": "{duration.fast}", "$type": "duration" },
      "easing": { "$value": "{easing.decelerate}", "$type": "cubicBezier" }
    },
    "progress": {
      "$description": "Progress rings, bars, and loading indicators",
      "duration": { "$value": "{duration.slow}", "$type": "duration" },
      "easing": { "$value": "{easing.default}", "$type": "cubicBezier" }
    },
    "celebrate": {
      "$description": "Success/celebration moments (goal reached, payment complete)",
      "duration": { "$value": "{duration.slower}", "$type": "duration" },
      "easing": { "$value": "{easing.spring}", "$type": "cubicBezier" }
    },
    "fadeIn": {
      "$description": "Content fade-in reveals (cards, sections, tooltips)",
      "duration": { "$value": "{duration.normal}", "$type": "duration" },
      "easing": { "$value": "{easing.decelerate}", "$type": "cubicBezier" }
    },
    "fadeOut": {
      "$description": "Content fade-out dismissals (toasts, overlays)",
      "duration": { "$value": "{duration.fast}", "$type": "duration" },
      "easing": { "$value": "{easing.accelerate}", "$type": "cubicBezier" }
    },
    "microInteraction": {
      "$description": "Small UI feedback (button press, toggle switch, checkbox)",
      "duration": { "$value": "{duration.instant}", "$type": "duration" },
      "easing": { "$value": "{easing.default}", "$type": "cubicBezier" }
    },
    "loading": {
      "$description": "Skeleton shimmer and continuous loading states",
      "duration": { "$value": "{duration.slower}", "$type": "duration" },
      "easing": { "$value": "{easing.inOut}", "$type": "cubicBezier" }
    }
  },
  "animationReduced": {
    "$description": "Reduced-motion equivalents of the animation.* semantic tokens. Consumers MUST switch to these when prefers-reduced-motion / OS Reduce Motion is enabled. Every purpose collapses to a near-instant, linear (no spring/overshoot) transition so animation-driven state changes still complete without vestibular-triggering motion. Mirrors every key in `animation`.",
    "pageTransition": {
      "$description": "Reduced-motion page transition — near-instant crossfade",
      "duration": { "$value": "{duration.reduced}", "$type": "duration" },
      "easing": { "$value": "{easing.linear}", "$type": "cubicBezier" }
    },
    "listItem": {
      "$description": "Reduced-motion list/grid item — no stagger, near-instant",
      "duration": { "$value": "{duration.reduced}", "$type": "duration" },
      "easing": { "$value": "{easing.linear}", "$type": "cubicBezier" }
    },
    "progress": {
      "$description": "Reduced-motion progress — snap to value without animated sweep",
      "duration": { "$value": "{duration.reduced}", "$type": "duration" },
      "easing": { "$value": "{easing.linear}", "$type": "cubicBezier" }
    },
    "celebrate": {
      "$description": "Reduced-motion celebration — spring/overshoot removed; show end state near-instantly",
      "duration": { "$value": "{duration.reduced}", "$type": "duration" },
      "easing": { "$value": "{easing.linear}", "$type": "cubicBezier" }
    },
    "fadeIn": {
      "$description": "Reduced-motion fade-in — near-instant reveal",
      "duration": { "$value": "{duration.reduced}", "$type": "duration" },
      "easing": { "$value": "{easing.linear}", "$type": "cubicBezier" }
    },
    "fadeOut": {
      "$description": "Reduced-motion fade-out — near-instant dismiss",
      "duration": { "$value": "{duration.reduced}", "$type": "duration" },
      "easing": { "$value": "{easing.linear}", "$type": "cubicBezier" }
    },
    "microInteraction": {
      "$description": "Reduced-motion micro-interaction — instant feedback, no easing curve",
      "duration": { "$value": "{duration.reduced}", "$type": "duration" },
      "easing": { "$value": "{easing.linear}", "$type": "cubicBezier" }
    },
    "loading": {
      "$description": "Reduced-motion loading — prefer a static/opacity-pulse indicator over sweeping shimmer",
      "duration": { "$value": "{duration.reduced}", "$type": "duration" },
      "easing": { "$value": "{easing.linear}", "$type": "cubicBezier" }
    }
  }
}
