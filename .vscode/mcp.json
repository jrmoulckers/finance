{
  // MCP server configuration for VS Code Copilot Agent Mode (JSONC — comments allowed).
  //
  // EXPLICIT LOCAL OVERLAY — NOT DRIFT. The canonical studio MCP policy is `agency.toml`
  // (synced from jrmoulckers/.github). That canon enables only the intrinsically bounded
  // servers by default and keeps `playwright` and `memory` as commented, pinned opt-ins
  // pending verification of the host's tool-filter enforcement. This file deliberately
  // declares a SUPERSET for the VS Code Agent Mode host: it adds `github`, `filesystem`
  // and `supabase`, and enables `playwright` and `memory`. That divergence is intentional
  // and member-owned — do not "reconcile" it against `agency.toml`, and do not treat it as
  // sync drift. `agency.toml` remains the canonical policy; this is the local runtime
  // opt-in recorded alongside it, per the note in that file. See docs/ai/mcp.md.
  //
  // SECURITY HARDENING (audit #2856/#2857/#2858/#2878/#2879):
  //   * Every npx server is pinned to an EXACT version — no @latest, no floating tags.
  //   * No secret is ever passed as a --flag=value on argv; secrets flow via ${input:...} (env/header).
  //   * Fabricated/non-existent packages were replaced with the official upstream packages.
  // Pins below were VERIFIED against the upstream npm registry on 2026-06-21 (latest published
  //   versions at that time). Bump deliberately and re-verify the version + publisher on any change.
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        // Read-only fine-grained PAT, provided via input prompt — never hardcoded.
        "Authorization": "Bearer ${input:github_mcp_pat}"
      }
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      // @modelcontextprotocol/server-sequential-thinking — publisher: Anthropic (modelcontextprotocol), MIT. Local only, no network/secrets.
      // Verified 2026-06-21: https://www.npmjs.com/package/@modelcontextprotocol/server-sequential-thinking
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking@2025.12.18"]
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      // @modelcontextprotocol/server-memory — publisher: Anthropic (modelcontextprotocol), MIT.
      // PRIVACY: NEVER persist PII, financial data, or secrets to the memory store (see docs/ai/mcp.md).
      // Verified 2026-06-21: https://www.npmjs.com/package/@modelcontextprotocol/server-memory
      "args": ["-y", "@modelcontextprotocol/server-memory@2026.1.26"]
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      // @modelcontextprotocol/server-filesystem — publisher: Anthropic (modelcontextprotocol), MIT.
      // LEAST-PRIVILEGE (#2879): rooted at an explicit dedicated dir via ${input:filesystem_root}, NOT the whole workspace.
      // WARNING: this server has NO deny-glob support and CAN read gitignored secrets under its root.
      //   Do NOT place .env*, *.key, or secrets/** under the served root. Prefer a dedicated, secret-free workdir.
      // Verified 2026-06-21: https://www.npmjs.com/package/@modelcontextprotocol/server-filesystem
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.1.14",
        "${input:filesystem_root}"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      // @upstash/context7-mcp — publisher: Upstash, MIT.
      // PRIVACY/DATA-FLOW: makes EXTERNAL network calls (sends library/query strings to Upstash). Do not send repo/financial data.
      // Verified 2026-06-21: https://www.npmjs.com/package/@upstash/context7-mcp
      "args": ["-y", "@upstash/context7-mcp@3.2.1"]
    },
    "supabase": {
      "type": "stdio",
      "command": "npx",
      // @supabase/mcp-server-supabase — publisher: Supabase, Apache-2.0. (Replaces fabricated @nicepkg/supabase-mcp.)
      // Use a READ-ONLY scoped token, never service_role (bypasses RLS).
      // The Management API token flows via the SUPABASE_ACCESS_TOKEN env var, NEVER on argv.
      // Verified 2026-06-21: https://www.npmjs.com/package/@supabase/mcp-server-supabase
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@0.8.2",
        "--read-only",
        "--project-ref=${input:supabase_project_ref}"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${input:supabase_access_token}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      // @playwright/mcp — publisher: Microsoft, Apache-2.0. (Replaces fabricated @anthropic/mcp-server-playwright; the @anthropic npm scope is unclaimed.)
      // Verified 2026-06-21 against https://github.com/microsoft/playwright-mcp (npm: @playwright/mcp)
      "args": ["-y", "@playwright/mcp@0.0.76"]
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "github_mcp_pat",
      "description": "GitHub PAT for MCP — use a READ-ONLY fine-grained token (see CONTRIBUTING.md)",
      "password": true
    },
    {
      "type": "promptString",
      "id": "filesystem_root",
      "description": "Absolute path to a DEDICATED working directory for the filesystem MCP server. Must NOT contain secrets (.env*, *.key, secrets/**). Avoid the repo root if it holds gitignored secrets. See docs/ai/mcp.md.",
      "password": false
    },
    {
      "type": "promptString",
      "id": "supabase_project_ref",
      "description": "Supabase project ref (short project id, e.g. abcdefghijklmnop) used for --project-ref scoping.",
      "password": false
    },
    {
      "type": "promptString",
      "id": "supabase_access_token",
      "description": "Supabase Management API personal access token — use a READ-ONLY scoped token, NEVER the service_role key (service_role bypasses RLS). TODO(human): provision a read-only token before use.",
      "password": true
    }
  ]
}
