#!/bin/sh
#
# pre-push hook (#2860) — fast local pre-flight before pushing.
#
# Runs: prettier format:check + eslint + a secret scan. These are a FAST
# pre-flight only; the AUTHORITATIVE gate is server-side CI (ci-security.yml /
# ci-lint.yml required status checks). A local bypass therefore cannot land an
# unverified change on `main`.
#
# Bypass (explicit + logged): set HUSKY=0 (the documented agent flow) or
# SKIP_PREPUSH=1. The bypass is logged loudly below — it is NOT a silent no-op.
#
# Install: git config core.hooksPath tools/git-hooks
#

# --- Explicit, logged escape hatch -------------------------------------------
# Honors the documented HUSKY=0 agent flow even when hooks are invoked directly
# via core.hooksPath (i.e. without husky's wrapper that would otherwise skip
# silently). We log a warning so a bypass is always visible in the output.
if [ "${HUSKY:-}" = "0" ] || [ "${SKIP_PREPUSH:-}" = "1" ]; then
  echo ""
  echo "⚠️  pre-push checks BYPASSED (HUSKY=0 / SKIP_PREPUSH=1)."
  echo "    Allowed for the documented agent flow, but this push was NOT locally"
  echo "    verified. Server-side required checks must still pass before merge."
  echo ""
  exit 0
fi

FAILED=0

run_check() {
  desc="$1"
  shift
  echo "▶ ${desc}"
  if ! "$@"; then
    echo "❌ ${desc} failed."
    FAILED=1
  fi
}

# --- 1. Formatting -----------------------------------------------------------
# `--no` avoids any network auto-install so the hook stays fast + non-interactive.
run_check "Prettier format:check" npx --no -- prettier --check .

# --- 2. Lint -----------------------------------------------------------------
run_check "ESLint" npx --no -- eslint . --max-warnings 0 --cache --cache-location .eslintcache

# --- 3. Secret scan (#2877) --------------------------------------------------
echo "▶ Secret scan"
SECRET_HIT=0
if command -v gitleaks >/dev/null 2>&1; then
  RANGE=""
  if git rev-parse '@{push}' >/dev/null 2>&1; then
    RANGE="$(git rev-parse '@{push}')..HEAD"
  elif git rev-parse '@{upstream}' >/dev/null 2>&1; then
    RANGE="$(git rev-parse '@{upstream}')..HEAD"
  fi
  if [ -n "$RANGE" ]; then
    gitleaks detect --redact --no-banner --config .gitleaks.toml --log-opts="$RANGE" || SECRET_HIT=1
  else
    # No upstream yet — scan the most recent commits as a backstop.
    gitleaks detect --redact --no-banner --config .gitleaks.toml --log-opts="-n 50" || SECRET_HIT=1
  fi
else
  echo "  gitleaks not installed; using regex backstop over tracked files."
  PATTERN='AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|-----BEGIN[ A-Z]*PRIVATE KEY-----|ghp_[0-9A-Za-z]{36}|gho_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{20,}|xox[baprs]-[0-9A-Za-z-]{10,}|sk_live_[0-9A-Za-z]{16,}|AIza[0-9A-Za-z_-]{35}'
  if git grep -nIE "$PATTERN" -- ':!*__tests__*' ':!*.test.*' ':!*.spec.*' ':!docs/*' ':!.gitleaks.toml' >/dev/null 2>&1; then
    echo "  potential secret(s) detected:"
    git grep -nIE "$PATTERN" -- ':!*__tests__*' ':!*.test.*' ':!*.spec.*' ':!docs/*' ':!.gitleaks.toml' | head -20
    SECRET_HIT=1
  fi
fi
if [ "$SECRET_HIT" -ne 0 ]; then
  echo "❌ Secret scan failed."
  FAILED=1
fi

# --- Result ------------------------------------------------------------------
if [ "$FAILED" -ne 0 ]; then
  echo ""
  echo "============================================================"
  echo "  ❌ pre-push checks FAILED — push blocked."
  echo "============================================================"
  echo "  Fix the issues above, then push again. If dependencies are"
  echo "  not installed locally, run 'npm ci' first."
  echo ""
  echo "  Explicit, logged bypass (documented agent flow):"
  echo "    HUSKY=0 git push        # or: SKIP_PREPUSH=1 git push"
  echo "  Server-side required checks remain the authoritative gate."
  echo ""
  exit 1
fi

echo "✅ pre-push checks passed."
exit 0
