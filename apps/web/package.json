{
  "name": "@finance/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts --project=chromium",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts --project=chromium-edge",
    "test:e2e:live:chromium": "playwright test --config=playwright.live.config.ts --project=chromium",
    "test:e2e:visual": "playwright test e2e/visual-regression.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "perf:budget": "node ../../tools/check-web-performance-budget.mjs --dist dist --budget performance.budget.json",
    "clean": "rimraf dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.331",
    "@sentry/react": "^10.63.0",
    "d3": "^7.9.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "sql.js": "^1.14.1",
    "tesseract.js": "^7.0.0",
    "wa-sqlite": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.5",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "^4.11.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "nanoid": "^6.0.0",
    "source-map-js": "^1.2.1",
    "storybook": "^10.4.6",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
