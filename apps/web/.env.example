# Finance Web App — Environment Variables
# Copy this file to .env.local and choose ONE of the modes below.
#
# Mode A — Demo (default): leave VITE_SUPABASE_URL unset or pointing at a
#   "placeholder" URL. Auth + data run entirely in the browser (localStorage +
#   SQLite-WASM); no backend required. Good for pure UI work.
#
# Mode B — Local full-stack (edge): run the Supabase CLI stack locally and point
#   the app at it to exercise REAL edge auth (GoTrue + auth-* edge functions +
#   Postgres/RLS). See docs/guides/full-stack-local.md. The ready-to-use local
#   values live in the "Local full-stack" block at the bottom of this file.
#   Tip: `npm --prefix services/api run setup:windows` starts the stack AND writes
#   apps/web/.env.local for you (URL + anon key captured from `supabase status`).
#
# Mode C — Hosted Supabase project: use your project's URL + anon key.

# Supabase Configuration (Mode C — hosted project)
# Uncomment and fill these in to target a hosted Supabase project. Left
# commented so a verbatim copy of this file lands in Mode A (demo) by default,
# matching the app's built-in placeholder fallback.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# PowerSync Configuration (offline-first sync engine)
VITE_POWERSYNC_URL=https://your-powersync-instance.powersync.com

# Auth Endpoints
VITE_LOGIN_ENDPOINT=/api/auth/login
VITE_REFRESH_ENDPOINT=/api/auth/refresh
VITE_LOGOUT_ENDPOINT=/api/auth/logout

# Beta/staging access control (optional)
# Comma-separated approved account emails. Leave empty/unset to disable the gate.
VITE_BETA_ALLOWED_EMAILS=

# Local Edge Functions proxy target (Vite dev only)
VITE_FUNCTIONS_PROXY_TARGET=http://127.0.0.1:54321

# Sync Configuration (optional — defaults to Supabase Edge Function path)
# VITE_SYNC_PUSH_ENDPOINT=/api/sync/push

# -----------------------------------------------------------------------------
# Local full-stack (Supabase CLI) — Mode B
# -----------------------------------------------------------------------------
# Uncomment these two lines (and comment out the Mode C values above) to point
# the web app at a local Supabase stack started with `supabase start`. These are
# the CLI's well-known, non-secret local development values — identical on every
# machine and only valid against localhost. Re-check them any time with
# `npx supabase status` from services/api.
#
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
