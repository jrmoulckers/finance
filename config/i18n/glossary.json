      "fr-FR": "Montant",
      "notes": "Monetary amount. 'Cantidad' is acceptable for non-monetary counts only."
    },
    {
      "concept": "Over budget",
      "en-US": "Over budget",
      "es-ES": "Presupuesto excedido",
      "fr-FR": "Budget dépassé"
    },
    {
